# Database
MONGODB_URI=mongodb://localhost:27017/skillbridge
MONGODB_TEST_URI=mongodb://localhost:27017/skillbridge_test

# Docker Compose only: root credentials for the local MongoDB container
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=devpassword
MONGO_DATABASE=skillbridge

# Docker Compose only: credentials for the app-scoped (non-root) database
# user created by server/scripts/init-mongo.js on first container start.
MONGO_APP_USERNAME=skillbridge_app
MONGO_APP_PASSWORD=change_this_app_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Frontend URL
CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis (caching layer — optional; the app degrades to no caching if
# unreachable, see server/config/redisClient.js)
REDIS_URL=redis://localhost:6379

# Sentry (error tracking — optional; the app runs normally without it, see
# server/config/sentry.js). Leave unset in local development.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate Limiting (general API ceiling)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate Limiting (auth endpoints — login/register/forgot-password only, a
# materially tighter budget than the general API limiter above to mitigate
# brute-force/credential-stuffing attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
