{
  "name": "skillbridge",
  "version": "1.0.0",
  "description": "AI-Powered Job & Internship Ecosystem",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "seed": "node server/scripts/seedData.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "job",
    "internship",
    "ai",
    "career",
    "recruitment"
  ],
  "author": "SkillBridge Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "compression": "^1.7.4",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.10.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "natural": "^6.5.0",
    "nodemailer": "^6.9.4",
    "openai": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.1",
    "sharp": "^0.32.5",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^8.2.0",
    "jest": "^29.6.2",
    "migrate-mongo": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "serve": "^14.2.6",
    "supertest": "^6.3.3"
  }
}
